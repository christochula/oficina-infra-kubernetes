environment             = "homolog"
service_name            = "oficina-api"
kubernetes_cluster_name = "oficina-homolog-eks"
kubernetes_namespace    = "oficina"

# HTTPS Gateway base, after auth deploy; public Datadog synthetic location.
api_base_url         = "https://REPLACE.execute-api.us-east-1.amazonaws.com"
synthetics_locations = ["aws:us-east-1"]
datadog_api_url      = "https://api.datadoghq.com/"
business_services   = ["oficina-api", "oficina-billing-service", "oficina-production-service"]

# Fill actual names from each service Terraform output. Requires Datadog AWS/SQS integration.
saga_queue_names = []
saga_dlq_names   = []
saga_pending_age_critical_seconds = 300

# Enable only after custom metrics have been ingested; one authoritative state.
manage_metric_tag_configuration = false
# DD_API_KEY and DD_APP_KEY must be environment variables, never tfvars.
notification_message = "Inspect the distributed trace and Saga history."
