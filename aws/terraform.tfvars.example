# Copie para terraform.tfvars (nao versionado) se rodar local.
# No CI os valores vem de TF_VAR_* / GitHub Environment.

project_name = "oficina"
environment  = "homolog"
aws_region   = "us-east-1"

kubernetes_version = "1.32"
instance_type      = "t3.medium"
node_min_size      = 2
node_desired_size  = 2
node_max_size      = 4

# AWS Academy: roles pre-existentes. Deixe vazio para derivar de account_id.
# lab_role_arn  = "arn:aws:iam::519768589921:role/LabRole"
# principal_arn = "arn:aws:iam::519768589921:role/voclabs"

# Datadog Agent (chaves vem do Secrets Manager em runtime, nunca aqui)
datadog_enabled = true
datadog_site    = "datadoghq.com"
# datadog_api_key / datadog_app_key -> TF_VAR_datadog_api_key etc no CI
